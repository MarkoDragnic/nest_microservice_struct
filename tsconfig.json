{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["jest", "node"],
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ],
      "@app/contracts": [
        "./libs/contracts/src"
      ],
      "@app/contracts/*": [
        "./libs/contracts/src/*"
      ],
      "@app/core": [
        "./libs/core/src"
      ],
      "@app/core/*": [
        "./libs/core/src/*"
      ],
      "@app/messaging": [
        "./libs/messaging/src"
      ],
      "@app/messaging/*": [
        "./libs/messaging/src/*"
      ],
      "@app/redis": [
        "./libs/redis/src"
      ],
      "@app/redis/*": [
        "./libs/redis/src/*"
      ],
      "@app/postgres": [
        "./libs/postgres/src"
      ],
      "@app/postgres/*": [
        "./libs/postgres/src/*"
      ],
      "@app/mongo": [
        "./libs/mongo/src"
      ],
      "@app/mongo/*": [
        "./libs/mongo/src/*"
      ]
    }
  }
}