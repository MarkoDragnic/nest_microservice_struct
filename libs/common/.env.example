# MongoDB — used by LoggerModule
MONGODB_LOGGER_URI=mongodb://localhost:27017/logs

# PostgreSQL — shared across pg_read / pg_write
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_trader
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password
POSTGRES_SSL=false
POSTGRES_SYNCHRONIZE=false
POSTGRES_MIGRATIONS_RUN=false
