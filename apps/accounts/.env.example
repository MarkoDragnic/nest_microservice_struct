# TCP transport
ACCOUNT_TCP_HOST=localhost
ACCOUNT_TCP_PORT=30005
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Downstream TCP clients
PG_WRITE_TCP_HOST=localhost
PG_WRITE_TCP_PORT=30006

# Encryption — 256-bit hex key for AES-256 credential encryption
ENCRYPTION_CREDENTIAL_KEY=your-64-char-hex-key

# Prometheus metrics endpoint
METRICS_PORT=9003
