# Instance ID — must be unique per replica
INSTANCE_ID=position-service

# TCP transport
POSITION_TCP_HOST=localhost
POSITION_TCP_PORT=30004
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Downstream TCP clients
PG_WRITE_TCP_HOST=localhost
PG_WRITE_TCP_PORT=30006
PG_READ_TCP_HOST=localhost
PG_READ_TCP_PORT=30007

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=position-service-consumer

# Prometheus metrics endpoint
METRICS_PORT=9005
