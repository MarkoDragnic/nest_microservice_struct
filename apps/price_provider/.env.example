NODE_ENV=development

# TCP transport
PRICE_PROVIDER_TCP_HOST=localhost
PRICE_PROVIDER_TCP_PORT=30015
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Redis — used for tick caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password

# Binance WebSocket
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws
RECONNECT_BASE_MS=2000
RECONNECT_MAX_MS=30000
JITTER=0.2

# Prometheus metrics endpoint
METRICS_PORT=9010
