NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Gateway IP whitelist — leave empty to disable IP filtering
ALLOWED_GATEWAY_IPS=

# Network
AUTH_HTTP_PORT=4030
AUTH_TCP_HOST=localhost
AUTH_TCP_PORT=30000
INTERNAL_RPC_TOKEN=your-internal-rpc-token

PG_WRITE_TCP_HOST=localhost
PG_WRITE_TCP_PORT=30006

PG_READ_TCP_HOST=localhost
PG_READ_TCP_PORT=30007

# JWT — access token (short-lived)
JWT_SECRET=your-jwt-secret-at-least-32-characters
JWT_EXPIRATION=900

# JWT — refresh token (long-lived, separate secret)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRATION=604800

# Redis — used for refresh token storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password
