# MongoDB — indicator storage
MONGODB_URI=mongodb://localhost:27017/

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=indicators-consumer

# Instance ID — must be unique per replica
INSTANCE_ID=indicators-1

# TCP transport
INDICATORS_TCP_HOST=localhost
INDICATORS_TCP_PORT=30002
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Downstream TCP clients
HISTORY_CLIENT_HOST=localhost
HISTORY_CLIENT_PORT=30003

# Redis — used for indicator caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password

# Prometheus metrics endpoint
METRICS_PORT=9007
