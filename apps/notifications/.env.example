# MongoDB — failed notification storage
MONGODB_URI=mongodb://localhost:27017/mail_logger

# Instance ID — must be unique per replica
INSTANCE_ID=notification-service

# TCP transport
NOTIFICATION_TCP_HOST=localhost
NOTIFICATION_TCP_PORT=30011
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-consumer-group

# Redis — used for BullMQ job queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password

# SMTP / Gmail OAuth2
SMTP_USER=your-email@gmail.com
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# Notification queue settings
NOTIFICATION_EMAIL_ATTEMPTS=5
NOTIFICATION_EMAIL_BACKOFF_TYPE=exponential
NOTIFICATION_EMAIL_BACKOFF_DELAY_MS=30000

# Prometheus metrics endpoint
METRICS_PORT=9008
