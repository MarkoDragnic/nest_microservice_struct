# TCP transport
ROBOTS_TCP_HOST=localhost
ROBOTS_TCP_PORT=30001
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Downstream TCP clients
PG_WRITE_TCP_HOST=localhost
PG_WRITE_TCP_PORT=30006
PG_READ_TCP_HOST=localhost
PG_READ_TCP_PORT=30007

# Redis: used for robot state caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password

# Prometheus metrics endpoint
METRICS_PORT=9004
