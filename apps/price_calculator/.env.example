# MongoDB: calculator storage
MONGODB_URI=mongodb://localhost:27017/

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=calculator-consumer

# Instance ID: must be unique per replica
INSTANCE_ID=calculator-1

# TCP transport
CALCULATOR_TCP_HOST=localhost
CALCULATOR_TCP_PORT=30012
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Redis: used for calculator coordination
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password

# Prometheus metrics endpoint
METRICS_PORT=9009
