# Instance ID: must be unique per replica
INSTANCE_ID=trader-1

# TCP transport
TRADER_TCP_HOST=localhost
TRADER_TCP_PORT=30010
INTERNAL_RPC_TOKEN=your-internal-rpc-token

# Downstream TCP clients
POSITION_CLIENT_HOST=localhost
POSITION_CLIENT_PORT=30004

ACCOUNT_CLIENT_HOST=localhost
ACCOUNT_CLIENT_PORT=30005

PG_READ_TCP_HOST=localhost
PG_READ_TCP_PORT=30007

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=trader-consumer

# Redis: used for symbol claim locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your-redis-password

# Trading settings
TICKER_MAX_AGE_MS=30000
SYMBOL_CLAIM_TTL_MS=30000

# Binance API
BINANCE_PROD_URL=https://api.binance.com
BINANCE_TEST_URL=https://testnet.binance.vision
BINANCE_TRADE_ENDPOINT=/api/v3/order

# Prometheus metrics endpoint
METRICS_PORT=9006
